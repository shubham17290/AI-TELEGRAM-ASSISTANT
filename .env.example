# Application
APP_NAME=AI Telegram Assistant
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_telegram_user_id_here

# AI/LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///telegram_bot.db
DATABASE_ECHO=false

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ADMIN_TELEGRAM_ID=your_telegram_user_id_here

# Rate Limiting
RATE_LIMIT=30
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=5
RATE_LIMIT_BURST_PERIOD=5

# Spam Detection
SPAM_DETECTION_ENABLED=true
SPAM_MAX_DUPLICATES=3
SPAM_DUPLICATE_WINDOW=60
SPAM_MAX_URLS=3
SPAM_MAX_MESSAGE_LENGTH=4096

# Timeouts (in seconds)
API_TIMEOUT=30
DB_QUERY_TIMEOUT=10
DB_POOL_TIMEOUT=30

# Secure Logging
LOG_REDACT_SECRETS=true
LOG_REDACT_PII=true
